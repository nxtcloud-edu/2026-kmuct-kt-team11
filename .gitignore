# Tracked on purpose: docs/

# ── Next.js / Node (from create-next-app) ──────────────────────────────
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.pem
*.tsbuildinfo
.DS_Store
.env*
# Re-negated AFTER the `.env*` above, not only after `.env.*` near the top of this
# file. A negation cannot survive a later broader match, so the `!.env.example` in
# the secrets block was silently overridden by this Next.js default block and the
# example file was uncommittable. Order matters here; do not move this line up.
!.env.example
.pnp.*
.pnpm-debug.log*
.vercel
.yarn/*
/.next/
/.pnp
/build
/coverage
/node_modules
/out/
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Supabase ──────────────────────────────────────────────────────────
supabase/.temp/
supabase/.branches/
.vercel
